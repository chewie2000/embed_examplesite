# Sigma Embed Credentials
# Obtain these from your Sigma org: Administration > Developer Access > Embedding
SIGMA_CLIENT_ID=
SIGMA_SECRET=

# Sigma Embed Base URL
# The published workbook/page URL from Sigma (without ?:embed=true)
# This is the default embed shown when no mode is active.
SIGMA_BASE_URL=

# Add one per nav section in DashboardShell.js NAV_ITEMS.
# The mode name (uppercase) becomes the env var prefix.
# Example: { label: 'Sales', mode: 'sales' } → SALES_SIGMA_BASE_URL
# SALES_SIGMA_BASE_URL=
# PROFIT_PLANNER_SIGMA_BASE_URL=
# MARKETING_SIGMA_BASE_URL=

# Anonymous embed (/interested page)
# Public, no-sign-on page that embeds Sigma using a STATIC JWT sub — every
# anonymous visitor maps to the same Sigma embed user. The JWT is signed
# server-side in app/interested/page.js; no JWT endpoint is exposed.
INTERESTED_SIGMA_BASE_URL=
# The static sub claim shared by all anonymous visitors (a single Sigma embed user).
ANONYMOUS_SIGMA_SUB=anonymous@embedsuccess.com
# The Sigma account type for the anonymous user (a custom 'anon' type in this demo).
ANONYMOUS_SIGMA_ACCOUNT_TYPE=anon

# Demo login credentials — set these in your environment, never hardcode in source
DEMO_USER_EMAIL=demo@embedsuccess.com
DEMO_USER_PASSWORD=
DEMO_USER_NAME=Demo User
DEMO_USER_SIGMA_EMAIL=

# Session secret — generate a strong random string (e.g. openssl rand -base64 32)
SESSION_SECRET=

# Optional: embed session length in seconds (default 3600 = 1 hour, max 2592000 = 30 days)
# SESSION_LENGTH=3600

# Optional: Sigma UI controls (uncomment to enable)
# hide_menu=true
# hide_folder_navigation=true
# disable_mobile_view=true
# responsive_height=true
# theme=
# lng=
